<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>

    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <ApplicationIcon>Resources\Aseguranza.ico</ApplicationIcon>

    <!--
      WebView2 currently exposes a WPF assembly to WinForms projects,
      which can produce MSB3277 for WindowsBase even when WPF is not used.
      Keep the WebView2 package intact and demote only this known warning.
    -->
    <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);MSB3277</MSBuildWarningsAsMessages>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Database\AseguranzaBD.sql" />
    <None Remove="Database\SQLite\AseguranzaSQLite.sql" />
    <None Remove="Plantillas\Certificacion.html" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Database\AseguranzaBD.sql">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>

    <Content Include="Database\SQLite\AseguranzaSQLite.sql">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>

    <Content Include="Plantillas\Certificacion.html">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <!--
      AForge 2.2.5 targets .NET Framework. The camera workflow has been
      validated in this application, so suppress NU1701 only for these
      specific legacy camera packages.
    -->
    <PackageReference Include="AForge" Version="2.2.5" NoWarn="NU1701" />
    <PackageReference Include="AForge.Video" Version="2.2.5" NoWarn="NU1701" />
    <PackageReference Include="AForge.Video.DirectShow" Version="2.2.5" NoWarn="NU1701" />

    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.3" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.23" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4129.50" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="10.0.2" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\LogoContecComprimida.png">
      <LogicalName>Aseguranza.Resources.LogoContecComprimida.png</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <None Include="Resources\Aseguranza.ico" />
    <None Include="Resources\AseguranzaIcon.png" />
  </ItemGroup>

  <ItemGroup>
    <!--
      portable.flag is not copied during normal Debug/Release execution.
      It is copied only when the application is published.
      Its presence makes ConfiguracionSistema keep configuration, SQLite,
      files and logs next to the portable application.
    -->
    <None Update="portable.flag">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

</Project>